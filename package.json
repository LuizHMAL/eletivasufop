{
  "name": "eletivasufop",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Eletivas UFOP - Monorepo (FastAPI + React)",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "uv run --directory api uvicorn index:app --reload --port 8000",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "test:backend": "uv run --directory api pytest",
    "install:all": "uv sync --directory api && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
